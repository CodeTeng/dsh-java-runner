{
  "name": "dsh-java-runner",
  "version": "0.1.0-alpha.0",
  "description": "Java compile, run, and test tools for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "java",
    "junit",
    "agent"
  ],
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.5",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
